QWidget {
    background-color: #ffffff;
}

QPushButton {
    background-color: #383838;
    color: white;
    border: none;
    border-radius: 7px;
    padding: 10px;
    font-size: 15px;
    setCursor: PointingHandCursor;
}

QPushButton::hover{
    background-color: #797979;
}


QLabel {
    color: #383838;
    font-size: 15px;
    font-weight: bold;
}

QLabel#colorName {
    color: red;
    font-size: 25px;
    font-weight: bold;
}

QLineEdit{
    border: 1px solid #383838;
    border-radius: 5px;
    height: 25px;
    display: flex;
    justify-content: center;
    font-size: 15px;
    padding: 5px
}

QScrollBar{
    border-radius: 15px;
    color: black;
}

QSpinBox {
    background-color: #ffffff;
    color: #383838;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 4px;
    font-size: 14px;
    font-weight: 600;
    min-width: 60px;

}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 0px;
    height: 0px;
    border: none;
}


QSlider::groove:horizontal {
    height: 6px;
    background: #cccccc;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    background: #383838;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #797979;
}

QSlider::sub-page:horizontal {
    background: #303030;
    border-radius: 2px;
}


QLabel#colorName {
    color: #797979;
    font-size: 15px;
    font-weight: bold;
}